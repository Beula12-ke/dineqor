// Copy to .env and fill in. Never commit .env - it holds real credentials.
// For local-only overrides use .env.local (also gitignored); it is loaded after .env and wins.

// APP_ENV: local | production. 'production' turns off display_errors.
APP_NAME=Dineqor
APP_ENV=local
APP_DEBUG=true

// APP_URL is the site's full URL. BASE_URL is derived from its path component
// ('http://localhost/dineqor' -> '/dineqor', 'https://example.com' -> '').
// Set APP_BASE_PATH explicitly only if that derivation is wrong for your install.
APP_URL=http://localhost/dineqor
APP_ORIGIN=http://localhost/dineqor
APP_BASE_DOMAIN=localhost
APP_BASE_PATH=
APP_TIMEZONE=Africa/Nairobi
APP_KEY=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=dineqor
DB_USER=root
DB_PASS=

MAIL_FROM=no-reply@localhost

SESSION_NAME=dineqor_session
SESSION_LIFETIME=120
SESSION_SECURE=false

UPLOAD_MAX_MB=5

MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCK_SECONDS=900